# Salin file ini menjadi .env lalu isi kunci API Anthropic Anda.
# Dapatkan kunci di https://console.anthropic.com (perlu mengisi saldo/billing).
ANTHROPIC_API_KEY=sk-ant-isi-kunci-anda-di-sini

# Opsional: model pembaca nota. claude-sonnet-5-5 (lebih teliti) atau claude-haiku-5-5 (lebih hemat)
NOTA_MODEL=claude-sonnet-5-5
