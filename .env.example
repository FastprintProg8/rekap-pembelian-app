# Pilihan database: "sqlite" atau "mysql"
# Jika "sqlite", file database data.db lokal akan digunakan secara otomatis.
# Jika "mysql", isi detail koneksi MySQL di bawah ini.
DB_DRIVER=sqlite

# Konfigurasi Database MySQL (hanya dipakai jika DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rekap_pembelian
DB_USER=root
DB_PASS=

# Salin file ini menjadi .env lalu isi kunci API Anthropic Anda jika ingin menggunakan fitur baca nota di server.
# Dapatkan kunci di https://console.anthropic.com (perlu mengisi saldo/billing).
ANTHROPIC_API_KEY=sk-ant-isi-kunci-anda-di-sini

# Opsional: model pembaca nota. claude-sonnet-5-5 (lebih teliti) atau claude-haiku-5-5 (lebih hemat)
NOTA_MODEL=claude-sonnet-5-5
